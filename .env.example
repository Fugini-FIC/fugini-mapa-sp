# Copie para .env (na raiz do projeto) e preencha. O .env NUNCA vai para o git.

# GitHub (publicação na gh-pages)
GITHUB_TOKEN=

# Google Maps
GOOGLE_API_KEY=

# Supabase (CRM)
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL do servidor de dados
PG_HOST=
PG_USER=
PG_PASSWORD=

# CSV de clientes do TOTVS — caminho UNC SEM aspas (entre aspas o dotenv come uma barra)
TOTVS_CLIENTE_CSV=\\servidor\pasta\totvs_cliente.csv

# Senhas dos mapas — iguais a vendedores.mapa_senha no Supabase
MAPA_SENHA_MASTER_SP=
MAPA_SENHA_VENDEDOR_SP01=
MAPA_SENHA_VENDEDOR_SP02=
MAPA_SENHA_VENDEDOR_SP03=
MAPA_SENHA_VENDEDOR_SP04=
